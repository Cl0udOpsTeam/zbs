# ZBS web UI. Serves the single-page app and proxies /api to the ZBS API
# service, so everything stays same-origin and an auth proxy in front of
# this container covers both the UI and its API calls.
#
# ${ZBS_UI_PORT} and ${ZBS_API_UPSTREAM} are substituted at container start
# by the stock nginx docker-entrypoint templates mechanism; nginx runtime
# variables like $host are left untouched.

server {
    listen ${ZBS_UI_PORT};
    server_name _;

    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass ${ZBS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
    }
}
